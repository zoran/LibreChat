{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "sourceMap": true,
    "inlineSources": true,
    "removeComments": false,
    "preserveConstEnums": true,
    "declarationMap": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "types",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/__tests__/**",
    "src/**/*.helper.ts",
    "src/**/*.fixture.ts"
  ]
}
